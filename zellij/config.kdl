// Only the settings that differ from zellij's defaults.
// Full reference: zellij setup --dump-config

default_shell "zsh"
default_layout "compact"
simplified_ui false
pane_frames false
theme "kanagawa"

themes {
    kanagawa {
        fg "#bfbdb6"
        bg "#0b0e14"
        black "#1e232b"
        red "#ea6c73"
        green "#7fd962"
        yellow "#f9af4f"
        blue "#53bdfa"
        magenta "#cda1fa"
        cyan "#90e1c6"
        white "#c7c7c7"
        orange "#ffb454"
        gray "#686868"
    }
}
